# Environment variables read by gps.config.settings (copy to .env to use locally).
# Only flat GPS_* fields come from env vars. Thresholds (stay_point, clustering,
# classification) are read from configs/{GPS_ENV}.yaml and are not env-overridable.

GPS_ENV=dev                 # dev | staging | prod -> configs/{GPS_ENV}.yaml
GPS_MODEL_VERSION=v1        # v1 = per-stay heuristic, v2 = DBSCAN places
GPS_LOG_LEVEL=INFO

# Paths used by the data pipeline and scripts
GPS_DATA_DIR=./data
GPS_PROCESSED_DATA_DIR=./data/processed
