# Environment variables template
# Copy to .env and fill in your values

# App
APP_NAME=gps-home-office-inference
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default
S3_BUCKET=your-bucket-name
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/your-queue

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=gps-inference

# Model
MODEL_VERSION=v1
MODEL_PATH=./models/v1
MODEL_REGISTRY=s3://your-bucket/models

# Stay-point detection thresholds
STAY_POINT_TIME_THRESHOLD_MINUTES=30
STAY_POINT_DISTANCE_THRESHOLD_METERS=200

# DBSCAN parameters
DBSCAN_EPS_METERS=100
DBSCAN_MIN_SAMPLES=3

# Privacy
GEOHASH_PRECISION=6
K_ANONYMITY_K=5

# Monitoring
PROMETHEUS_PORT=9090
ENABLE_DRIFT_DETECTION=true
